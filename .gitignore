/target
**/*.rs.bk

# Fidelity harness scratch output (expected snapshots ARE committed).
/corpus/**/actual/

# Real documents dropped here to look at by hand. Deliberately never committed:
# they are somebody else's, they arrive without anyone reviewing what is in
# them, and a commit puts them in the history for good. The corpus is where
# test documents go, and everything in it is generated by `cargo xtask corpus`.
/manual_examples/

# What Python compiles beside the scripts under tools/ and .claude/hooks/ when
# they run. It is regenerated on every run and belongs to no one.
__pycache__/
